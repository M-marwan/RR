# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=rr_command_center
POSTGRES_USER=rr_admin
POSTGRES_PASSWORD=rr_secret_change_me
DATABASE_URL=postgresql://rr_admin:rr_secret_change_me@localhost:5432/rr_command_center

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Claude CLI ───────────────────────────────────────────────────────────────
# The Claude CLI must be installed on the host (not in Docker).
# Find it with: where claude
CLAUDE_CLI_PATH=claude
CLAUDE_MAX_CONCURRENT_CALLS=2
CLAUDE_RATE_LIMIT_DELAY_SECONDS=5

# ── Gmail — Marwan's primary account ─────────────────────────────────────────
# Get these from Google Cloud Console → APIs → Gmail API → OAuth2 credentials
GMAIL_MARWAN_CLIENT_ID=
GMAIL_MARWAN_CLIENT_SECRET=
GMAIL_MARWAN_TOKEN_PATH=data/credentials/gmail_marwan.json
GMAIL_MARWAN_ADDRESS=014.marwan@gmail.com

# ── Gmail — Subscriptions inbox (for paid newsletters) ───────────────────────
GMAIL_SUBSCRIPTIONS_TOKEN_PATH=data/credentials/gmail_subscriptions.json
GMAIL_SUBSCRIPTIONS_ADDRESS=rr.subscriptions@gmail.com

# ── Twitter / X API v2 ───────────────────────────────────────────────────────
# Free tier: 500K reads/month — get from developer.twitter.com
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ── Brave Search API ─────────────────────────────────────────────────────────
# Free tier: 2,000 queries/month — get from api.search.brave.com
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_DAILY_QUOTA=65

# ── Paid News Portals (credentials never stored in DB) ───────────────────────
KPLER_USERNAME=
KPLER_PASSWORD=
PLATTS_USERNAME=
PLATTS_PASSWORD=
BLOOMBERG_USERNAME=
BLOOMBERG_PASSWORD=
SP_GLOBAL_USERNAME=
SP_GLOBAL_PASSWORD=

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Dubai

# ── RR System source path (for seed script) ──────────────────────────────────
RR_SOURCE_PATH=C:/Users/HELIOS/OneDrive - giavc.com/Desktop/Claude/.claude/RR/RR

# ── Microsoft Entra (Azure AD) auth ──────────────────────────────────────────
# Leave both empty in dev to disable auth (every request gets a synthetic
# dev-principal user). Set both to enable Bearer JWT validation on /api/*.
# 1. Register an app in https://entra.microsoft.com → App registrations
# 2. Copy Directory (tenant) ID and Application (client) ID into these vars
# 3. Configure the SPA redirect URI to your frontend URL
# 4. Expose a scope (e.g. "api.access") and grant admin consent
MS_TENANT_ID=
MS_CLIENT_ID=
# Optional: comma-separated UPNs that bypass auth even when MS_* is set.
# Use ONLY for the principal's local laptop, never in prod.
MS_DEV_BYPASS_EMAILS=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MS_TENANT_ID=
NEXT_PUBLIC_MS_CLIENT_ID=
